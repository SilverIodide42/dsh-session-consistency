{
  "name": "dsh-session-manager",
  "version": "0.1.0",
  "type": "module",
  "description": "DSH (DeepSeek Harness) session manager plugin: three-store consistency check across session dirs / projcache / workspace.json, backup-first cleanup, archive management and workspace health check in a Web GUI panel.",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "session-manager",
    "cleanup",
    "workspace-health",
    "web-gui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilverIodide42/dsh-session-manager.git"
  },
  "homepage": "https://github.com/SilverIodide42/dsh-session-manager#readme",
  "bugs": {
    "url": "https://github.com/SilverIodide42/dsh-session-manager/issues"
  },
  "author": "SilverIodide42",
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "license": "MIT"
}
